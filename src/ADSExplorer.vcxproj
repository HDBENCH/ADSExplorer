  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- ================================================================
       After a Release|x64 build, produce dist\ADSExplorer-&lt;ver&gt;.msi.
         * Disable with BuildMsi=false (e.g. msbuild /p:BuildMsi=false)
         * If WiX v6 (the dotnet tool) is missing, warn and skip so the
           DLL build itself still succeeds
       ================================================================ -->
  <PropertyGroup>
    <BuildMsi Condition="'$(BuildMsi)'==''">true</BuildMsi>
    <!-- MsiVersion is an override only. Left empty, build-msi.ps1 reads
         PRODUCTVERSION out of ADSExplorer.rc, which is the single source of
         truth for the version number. -->
    <MsiVersionArg Condition="'$(MsiVersion)'!=''">-Version $(MsiVersion)</MsiVersionArg>
    <WixExe Condition="'$(WixExe)'==''">$(UserProfile)\.dotnet\tools\wix.exe</WixExe>
    <RepoRoot>$(ProjectDir)..\</RepoRoot>
  </PropertyGroup>
  <!-- Inputs/Outputs are evaluated before the target runs, so this ItemGroup
       has to live outside it. Declared inside, it would evaluate to empty
       and the target would rebuild every time. -->
  <ItemGroup>
    <MsiSource Include="$(RepoRoot)installer\wix\*.wxs;$(RepoRoot)installer\wix\*.wxl;$(RepoRoot)installer\wix\*.txt;$(RepoRoot)installer\*.txt;$(RepoRoot)installer\*.bat;$(RepoRoot)installer\manual\*.txt" />
  </ItemGroup>
  <!-- The real outputs carry the version in their file names, which MSBuild
       cannot know before running the script. The script therefore writes a
       fixed-name stamp file that drives the up-to-date check instead. -->
  <Target Name="BuildMsiPackage" AfterTargets="Build"
          Condition="'$(BuildMsi)'=='true' AND '$(Configuration)'=='Release' AND '$(Platform)'=='x64'"
          Inputs="$(OutDir)ADSExplorer.dll;$(RepoRoot)src\ADSExplorer.rc;$(RepoRoot)tools\build-msi.ps1;@(MsiSource)"
          Outputs="$(RepoRoot)dist\.build-stamp">
    <Warning Condition="!Exists('$(WixExe)')"
             Text="WiX v6 not found, skipping MSI generation ($(WixExe)). To install: dotnet tool install --global wix --version 6.* &amp;&amp; wix extension add -g WixToolset.UI.wixext/6.0.2" />
    <Exec Condition="Exists('$(WixExe)')"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoRoot)tools\build-msi.ps1&quot; $(MsiVersionArg)"
          WorkingDirectory="$(RepoRoot)" />
  </Target>
</Project>